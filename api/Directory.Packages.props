    <PackageVersion Include="FastEndpoints" Version="9.0.0" />
    <PackageVersion Include="FastEndpoints.Security" Version="9.0.0" />
    <PackageVersion Include="FastEndpoints.Swagger" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Azure" Version="1.14.1" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.18.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NSwag.AspNetCore" Version="14.8.0" />
    <PackageVersion Include="NSwag.MSBuild" Version="14.8.0" />
    <PackageVersion Include="PxBunny.Result" Version="0.0.1" />
    <PackageVersion Include="PxBunny.Result.Generator" Version="0.0.4" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
