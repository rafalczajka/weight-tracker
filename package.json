{
  "name": "weight-tracker",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm --filter @weight-tracker/api-client generate",
    "lint": "turbo run lint",
    "preinstall": "git config --local core.hooksPath .githooks",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "2.8.8",
    "turbo": "2.10.9"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.3"
}
