#!/bin/sh

set -e

root_dir=$(git rev-parse --show-toplevel)

. "$root_dir/scripts/venv.sh"
set_tools_venv_python "$root_dir/app-cli"

echo "🚀 Running pre-commit hook 🚀"

files=$(git diff --cached --name-only --diff-filter=d "*.py")

if [ -n "$files" ]; then
  echo -e "\n✨ Sorting imports..."
  "$TOOLS_VENV_PY" -m ruff check --select I --fix $files
  git add $files

  echo -e "\n✨ Linting and formatting..."
  "$TOOLS_VENV_PY" -m ruff check $files
  "$TOOLS_VENV_PY" -m ruff format $files
fi

cd "$root_dir/app-mobile"

mobile_files=$(git diff --cached --name-only --diff-filter=d --relative -- "*.js" "*.jsx" "*.ts" "*.tsx" "*.mjs" "*.cjs")

if [ -n "$mobile_files" ]; then
  echo -e "\n✨ Linting and formatting mobile files..."
  npm exec -- eslint --fix $mobile_files
  npm exec -- prettier --write $mobile_files
  git add $mobile_files
  npm exec -- eslint --max-warnings=0 $mobile_files
fi

echo -e "\n🎉 Pre-commit status: success 🎉\n"
